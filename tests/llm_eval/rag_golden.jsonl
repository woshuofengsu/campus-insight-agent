# tests/llm_eval/rag_golden.jsonl — RAG 检索命中率 golden 集（U1 混合检索）
#
# 每行：{"query": 居民口语提问, "expect_any": [期望 top-k 结果中命中的关键词（任一即可）], "note": 说明}
# 用途：scripts/rag_eval.py 量化检索召回；覆盖「口语→政策书面语」的同义鸿沟。
# 注意：期望关键词要与知识库条目的标题/关键词/正文实际用词匹配（可在导入语料后调整）。

{"query": "老楼装电梯怎么申请", "expect_any": ["加装电梯", "增设电梯", "电梯"], "note": "口语「老楼装电梯」→ 政策「既有多层住宅增设电梯」"}
{"query": "加装电梯费用怎么分摊", "expect_any": ["电梯", "分摊", "费用"], "note": "电梯费用分摊"}
{"query": "医保怎么报销", "expect_any": ["医保", "医疗保险", "报销"], "note": "医保报销"}
{"query": "退休了每月能领多少钱", "expect_any": ["养老", "退休", "养老金"], "note": "口语「退休领钱」→ 养老金/养老待遇"}
{"query": "老人有什么补贴可以领", "expect_any": ["补贴", "津贴", "养老", "老年"], "note": "老年补贴/高龄津贴"}
{"query": "老年人高龄津贴怎么申请", "expect_any": ["高龄", "津贴", "补贴"], "note": "高龄津贴"}
{"query": "家里困难能申请什么救助", "expect_any": ["救助", "低保", "最低生活保障"], "note": "社会救助/低保"}
{"query": "公租房怎么申请", "expect_any": ["公租房", "公共租赁住房", "保障"], "note": "住房保障"}
{"query": "物业费太贵了找谁说", "expect_any": ["物业", "物业管理"], "note": "物业管理"}
{"query": "垃圾桶满了没人清运", "expect_any": ["垃圾", "清运", "分类"], "note": "环境卫生"}
{"query": "小区停车位不够怎么办", "expect_any": ["停车", "车位"], "note": "停车管理"}
{"query": "暖气不热怎么投诉", "expect_any": ["供暖", "供热", "采暖"], "note": "供暖问题"}
{"query": "楼道消防通道被堵了", "expect_any": ["消防", "安全", "通道"], "note": "消防安全"}
{"query": "电动车在楼道充电危险吗", "expect_any": ["电动车", "充电", "消防"], "note": "电动车充电安全"}
{"query": "生孩子有什么待遇", "expect_any": ["生育", "产假", "津贴"], "note": "生育待遇"}
{"query": "公积金怎么取出来", "expect_any": ["公积金", "提取"], "note": "公积金提取"}
{"query": "残疾人能领什么补助", "expect_any": ["残疾", "补贴", "补助"], "note": "残疾人补贴"}
{"query": "老旧小区什么时候改造", "expect_any": ["老旧小区", "改造", "整治"], "note": "老旧小区改造"}
{"query": "有事找政府打什么电话", "expect_any": ["12345", "接诉即办", "热线"], "note": "接诉即办"}
{"query": "社区有没有养老驿站", "expect_any": ["养老", "驿站", "居家"], "note": "社区养老服务"}
