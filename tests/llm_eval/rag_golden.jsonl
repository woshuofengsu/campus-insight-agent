# tests/llm_eval/rag_golden.jsonl — RAG 检索命中率 golden 集（U1 混合检索）
#
# 每行：{"query": 居民口语提问, "expect_any": [期望 top-k 结果中命中的关键词（任一即可）], "note": 说明}
# 用途：scripts/rag_eval.py 量化检索召回；覆盖「口语→政策书面语」的同义鸿沟。
# 注意：期望关键词要与知识库条目的标题/关键词/正文实际用词匹配（可在导入语料后调整）。

{"query": "老楼装电梯怎么申请", "expect_any": ["加装电梯", "增设电梯", "电梯"], "note": "口语「老楼装电梯」→ 政策「既有多层住宅增设电梯」"}
{"query": "加装电梯费用怎么分摊", "expect_any": ["电梯", "分摊", "费用"], "note": "电梯费用分摊"}
{"query": "医保怎么报销", "expect_any": ["医保", "医疗保险", "报销"], "note": "医保报销"}
{"query": "退休了每月能领多少钱", "expect_any": ["养老", "退休", "养老金"], "note": "口语「退休领钱」→ 养老金/养老待遇"}
{"query": "老人有什么补贴可以领", "expect_any": ["补贴", "津贴", "养老", "老年"], "note": "老年补贴/高龄津贴"}
{"query": "老年人高龄津贴怎么申请", "expect_any": ["高龄", "津贴", "补贴"], "note": "高龄津贴"}
{"query": "家里困难能申请什么救助", "expect_any": ["救助", "低保", "最低生活保障"], "note": "社会救助/低保"}
{"query": "公租房怎么申请", "expect_any": ["公租房", "公共租赁住房", "保障"], "note": "住房保障"}
{"query": "物业费太贵了找谁说", "expect_any": ["物业", "物业管理"], "note": "物业管理"}
{"query": "垃圾桶满了没人清运", "expect_any": ["垃圾", "清运", "分类"], "note": "环境卫生"}
{"query": "小区停车位不够怎么办", "expect_any": ["停车", "车位"], "note": "停车管理"}
{"query": "暖气不热怎么投诉", "expect_any": ["供暖", "供热", "采暖"], "note": "供暖问题"}
{"query": "楼道消防通道被堵了", "expect_any": ["消防", "安全", "通道"], "note": "消防安全"}
{"query": "电动车在楼道充电危险吗", "expect_any": ["电动车", "充电", "消防"], "note": "电动车充电安全"}
{"query": "生孩子有什么待遇", "expect_any": ["生育", "产假", "津贴"], "note": "生育待遇"}
{"query": "公积金怎么取出来", "expect_any": ["公积金", "提取"], "note": "公积金提取"}
{"query": "残疾人能领什么补助", "expect_any": ["残疾", "补贴", "补助"], "note": "残疾人补贴"}
{"query": "老旧小区什么时候改造", "expect_any": ["老旧小区", "改造", "整治"], "note": "老旧小区改造"}
{"query": "有事找政府打什么电话", "expect_any": ["12345", "接诉即办", "热线"], "note": "接诉即办"}
{"query": "社区有没有养老驿站", "expect_any": ["养老", "驿站", "居家"], "note": "社区养老服务"}

# ---- U1 语义难例（改述，几乎无字面重叠；用于对比「纯词法 vs 混合检索」）----
# 实测（2026-08，59 条知识库）：纯词法 3/7 → 混合检索 6/7。
# 典型纠正：「看病花光了积蓄」词法误给「加装电梯」→ 混合给「医保共济」；
#           「穷人租不起房」词法无结果 → 混合给「市场租房补贴」。

{"query": "家里老人一个人住不放心", "expect_any": ["独居", "居家安全", "老人"], "note": "语义难例 → 独居老人关爱"}
{"query": "看病花光了积蓄怎么办", "expect_any": ["救助", "医保", "医疗"], "note": "语义难例 → 医疗救助/医保共济"}
{"query": "外地住院的钱怎么报", "expect_any": ["异地就医", "结算", "医保"], "note": "语义难例 → 异地就医直接结算"}
{"query": "老楼上下楼不方便", "expect_any": ["电梯"], "note": "语义难例：句中不含「电梯」二字 → 加装电梯"}
{"query": "小区里车位抢不到", "expect_any": ["停车", "车位"], "note": "语义难例 → 停车管理"}
{"query": "穷人租不起房", "expect_any": ["公共租赁住房", "租房补贴", "保障"], "note": "语义难例 → 保障性住房/租房补贴"}
{"query": "残疾人有没有照顾", "expect_any": ["残疾", "补贴", "护理"], "note": "语义难例 → 残疾人两项补贴"}

# ---- 老人口语集（15 条，面向老年端的真实说话方式：短、含糊、带亲属称呼）----
# 特点：句子短、常省略主语/对象、口语化（「啥时候」「咋弄」「管饭吗」），
# 是检验「同义词扩展 + 语义向量」是否真的服务到老年人的关键样本。

{"query": "养老金啥时候发", "expect_any": ["养老", "退休", "津贴", "补贴"], "note": "老人口语 → 养老金/养老待遇"}
{"query": "腿脚不好，下楼费劲", "expect_any": ["电梯"], "note": "老人口语：不说「电梯」 → 加装电梯"}
{"query": "我一个人在家没人说话", "expect_any": ["独居", "关爱", "养老", "助餐"], "note": "老人口语 → 独居关爱/养老服务"}
{"query": "社区管饭吗", "expect_any": ["助餐", "养老", "驿站"], "note": "老人口语 → 养老助餐/驿站"}
{"query": "孩子不在身边，办事找谁", "expect_any": ["12345", "接诉即办", "社区", "热线"], "note": "老人口语 → 接诉即办/社区帮办"}
{"query": "残疾证能领啥钱", "expect_any": ["残疾", "补贴", "护理"], "note": "老人口语 → 残疾人两项补贴"}
{"query": "冬天屋里冷，暖气不热", "expect_any": ["供暖", "供热", "采暖"], "note": "老人口语 → 供暖诉求"}
{"query": "楼道堆东西绊人", "expect_any": ["消防", "楼道", "通道"], "note": "老人口语 → 消防通道/楼道堆物"}
{"query": "医保卡里的钱能给老伴用吗", "expect_any": ["共济", "医保", "个人账户"], "note": "老人口语 → 医保个人账户共济"}
{"query": "去外地看病咋报", "expect_any": ["异地就医", "结算", "医保"], "note": "老人口语 → 异地就医直接结算"}
{"query": "家里困难能申请啥补助", "expect_any": ["低保", "救助", "补贴"], "note": "老人口语 → 低保/社会救助"}
{"query": "楼里能装电梯不，我出钱", "expect_any": ["电梯"], "note": "老人口语 → 加装电梯意愿"}
{"query": "垃圾咋分类，我记不住", "expect_any": ["垃圾分类", "垃圾"], "note": "老人口语 → 垃圾分类"}
{"query": "电动车能不能在楼道里充电", "expect_any": ["电动车", "充电", "消防"], "note": "老人口语 → 电动车充电安全"}
{"query": "退休金每年涨不涨", "expect_any": ["养老", "退休", "养老金"], "note": "老人口语 → 养老金/养老待遇"}
{"query": "小区助餐点老人吃饭有补贴吗", "region": "海淀小区", "expect_any": ["助餐"], "expect_top1": true, "note": "属地优先（社区级）：本社区助餐指引排第一；同一句不带属地时是北京市方案"}
{"query": "高龄津贴多少钱一个月", "region": "海淀小区", "expect_any": ["高龄", "津贴"], "expect_top1": true, "note": "属地优先（区级）：海淀区细则排第一"}
{"query": "高龄津贴多少钱一个月", "expect_any": ["高龄", "津贴"], "note": "无属地兜底：仍能召回高龄津贴相关条目（属地不是过滤器）"}
{"query": "老旧小区加装电梯补贴怎么申请", "region": "朝阳试点社区", "expect_any": ["电梯"], "expect_top1": true, "note": "本地无区级政策 → 市级政策兜底（属地优先不等于属地过滤）"}
{"query": "助餐补贴怎么登记", "region": "海淀小区", "expect_any": ["助餐"], "expect_top1": true, "note": "社区级条目在属地内排第一"}
{"query": "外地的高龄补贴政策在这里适用吗", "region": "海淀小区", "expect_any": ["高龄", "津贴", "补贴"], "note": "外地政策被软降权但不过滤（仍可发现）"}
