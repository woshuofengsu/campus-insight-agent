# 生产/试点环境变量模板 —— 复制成 deploy/.env.production 后逐项填写
#
#   cp deploy/.env.production.example deploy/.env.production
#   # 填完后：chmod 600 deploy/.env.production
#
# ⚠️ 三条红线：
#   ① `.env.production` **绝不进仓库**（.gitignore 已覆盖 .env*），也**绝不进提交包**；
#   ② 下面两个密钥**必须自己生成**，不要用 `.env.demo` 里的占位值
#      （生产姿态下用仓库公开占位值会**拒绝启动**，这是有意的 fail-closed）；
#   ③ staging 与 production 用**两套完全不同的密钥与数据库**，不许共用。

# ---------------------------------------------------------------- 域名与姿态
# 站点域名（Caddy 用它自动申请证书）。备案完成后再填真实域名。
SITE_ADDRESS=insight.example.org
# 镜像标签：试点阶段用 pilot，便于回滚到上一个已知可用版本
APP_TAG=pilot
TZ=Asia/Shanghai

# ---------------------------------------------------------------- 密钥（必填）
# 生成方式（任选其一，各自独立、不要复用）：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WEB_JWT_SECRET=
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CRYPTO_KEY=

# ---------------------------------------------------------------- 数据库
# ⚠️ 当前**应用本体只支持 SQLite**（PostgreSQL 迁移属阶段 1B，**尚未执行**，
#    见 docs/spec/升级方案/PG迁移盘点与计划.md）。所以试点阶段请用 sqlite：
#    · `DB_BACKEND` 目前只影响**备份容器**用哪个工具（sqlite 快照 / pg_dump），
#      **不会**让应用切到 Postgres —— 填 postgres 而应用仍是 SQLite 是错的组合。
DB_BACKEND=sqlite
# 库文件路径（可选）。默认在镜像内 /app/data/community_insight.db（由 compose 挂卷持久化）。
# staging 与 production **必须各自独立的库**：同一台机器上跑两套环境时用这个变量区分，
# 别让预发把生产库写坏（空库初始化演练就是靠它做到"不碰演示库"的）。
# COMMUNITY_DB_PATH=/data/community_insight.db

# 以下 PG 变量**现在不用填**（留给阶段 1B：迁移演练通过后才允许切）：
# DATABASE_URL=postgresql://community:密码@db:5432/community
PG_DB=community
PG_USER=community
PG_PASSWORD=

# 备份保留份数（每天 1 份 → 14 份≈两周）
BACKUP_KEEP=14

# ---------------------------------------------------------------- 外部服务（可留空）
# 留空即降级为规则路径（不影响报修/进度/通知这些试点主流程）
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
QWEATHER_KEY=

# ---------------------------------------------------------------- 演示数据隔离（试点期硬边界）
# 生产**必须**关掉演示登录、演示种子与自动替人办结；staging 可以开。
# ⚠️ 这一项写错，等于把演示账号开在真实社区里。
DEMO_MODE=false
# 下面两项**默认跟随 DEMO_MODE**（2026-10-06 改：原来它们默认恒为 true，
# 于是"忘了写"就会在生产库里自动种演示数据 / 自动替网格员推进工单）。显式写出来是为了
# 让"我们确实关掉了"这件事在配置里看得见，而不是靠默认值。
SEED_DEMO_DATA=false
DEMO_AUTO_WORKER=false

# ---------------------------------------------------------------- 空库初始化（首次部署）
# ① 起服务建表（只会建结构 + 跑迁移到最新 schema，**不灌任何演示数据/账号**）：
#      docker compose up -d app && docker compose logs -f app
# ② 建**第一个社区负责人账号**（空库里一个账号都没有，不建就登不进去）：
#      docker compose exec app python scripts/bootstrap_admin.py \
#        --username zhuren01 --name 王主任 --community 幸福里社区 --generate-password
# ③ 核对"生产红线"真的成立（本机也能跑，不碰演示库）：
#      python scripts/empty_db_drill.py        # 空库初始化 / 不灌演示数据 / 缺密钥拒绝启动
#      python scripts/restore_drill.py         # 备份可恢复（六项校验）
