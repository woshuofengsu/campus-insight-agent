# ===== 演示姿态 .env.demo（WS8/H1） =====
# 用法：答辩演示前 `Copy-Item .env.demo .env`（或 `cp .env.demo .env`），
#       并填入真实 DEEPSEEK_API_KEY。
# 要点：开启全部"生成链路"开关，让招牌能力（政策自动生成/意图兜底/自主协商）真正可演示。
# 注意：本文件是模板，不含真实密钥，可入库；生产请回到正式 .env（开关全关 + 强 JWT + CORS 白名单）。

# ---- 大模型（演示必须真实 key，否则生成链路自动回落规则，无法展示 AI 能力）----
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- 演示模式（一键演示账号 / 工单闭环机器人）----
DEMO_MODE=true
DEMO_AUTO_WORKER=true

# ---- 生成链路开关（WS2/3/4；生产必须全部关闭）----
# 1) 自主协商编排：多 Agent LLM 决定是否跨角色联动
LLM_ORCHESTRATION=1
# 2) 政策真 RAG：政策弱命中 → 基于知识库生成（含结构化引用校验）
POLICY_LLM_RAG=1
# 3) 接待员 LLM 二级意图兜底：规则未命中 → LLM 白名单判别
RECEPTION_LLM_FALLBACK=1

# ---- 认证（演示兜底即可；正式用自有）----
WEB_JWT_SECRET=demo-please-set-a-production-secret
CRYPTO_KEY=demo-please-set-a-crypto-key

# ---- CORS（演示本机开发端口）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
