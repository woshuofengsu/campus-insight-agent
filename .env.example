# ── DeepSeek API（注册: https://platform.deepseek.com） ──
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── 和风天气 API（免费注册: https://id.qweather.com） ──
HEFENG_API_KEY=your-hefeng-key-here
HEFENG_API_HOST=your-api-host-here

# ── 安全密钥（**生产必配**；DEMO_MODE=false 时缺任一项会拒绝启动）──
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
#   WEB_JWT_SECRET：JWT 签名密钥（未配且未显式 DEMO_MODE=true → 拒绝启动）
#   CRYPTO_KEY    ：手机号等敏感字段加密密钥（未配/用仓库占位值 + DEMO_MODE=false → 拒绝启动）
# 注意：**不要**直接使用 .env.demo 里的 demo-please-set-* 占位值，那些是入库的公开字符串。
# WEB_JWT_SECRET=请替换为随机串
# CRYPTO_KEY=请替换为随机串

# ── 离线演示模式（设为 true 时不调用外部 API） ──
# OFFLINE_MODE=false

# ── 演示模式（设为 true 时显示「切换账号」等演示专用功能；正式使用务必关闭以隔离双角色） ──
# DEMO_MODE=false

# ── API 服务认证（API 端点用；留空则不验证，生产环境必设） ──
# COMMUNITY_API_KEY=your-secret-api-key

# ── 邮件通知（QQ 邮箱 SMTP；可选，未配置则跳过发送） ──
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=your-qq-number@qq.com
# SMTP_PASS=你的QQ邮箱授权码（不是登录密码）
# SMTP_TO=收件人邮箱（留空则发给自己）

# ── 社区设置 ──
COMMUNITY_CITY=北京
COMMUNITY_CITY_ID=101010100
COMMUNITY_DISTRICT=海淀区
# COMMUNITY_BG_IMAGE=   # 可选：登录页背景图片 URL

# ── 演示账号（系统自动创建，首次启动时生效） ──
# 居民：demo_resident（无需密码）
# 网格员：demo_grid / demo123
# 老年关怀版：demo_elderly（无需密码）
# 也可在登录页注册新居民账号
