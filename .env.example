# ── DeepSeek API（注册: https://platform.deepseek.com） ──
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── 和风天气 API（免费注册: https://id.qweather.com） ──
HEFENG_API_KEY=your-hefeng-key-here
HEFENG_API_HOST=your-api-host-here

# ── 离线演示模式（设为 true 时不调用外部 API） ──
# OFFLINE_MODE=false

# ── API 服务认证（API 端点用；留空则不验证，生产环境必设） ──
# CAMPUS_API_KEY=your-secret-api-key

# ── 校园设置 ──
CAMPUS_CITY=北京
CAMPUS_CITY_ID=101010100
CAMPUS_DISTRICT=海淀区
# CAMPUS_BG_IMAGE=   # 可选：登录页背景图片 URL

# ── 演示账号（系统自动创建，首次启动时生效） ──
# 学生：zhangsan / lisi / wangwu（无需密码）
# 教师：teacher / admin123
# 也可在登录页注册新学生账号
